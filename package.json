{
  "name": "wasla-platform",
  "version": "1.0.0",
  "private": true,
  "description": "WASLA - Global commerce and business network",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @wasla/api db:generate",
    "db:migrate": "pnpm --filter @wasla/api db:migrate",
    "db:check": "pnpm --filter @wasla/api db:check"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "@rollup/rollup-linux-x64-gnu": "4.68.0"
  }
}
