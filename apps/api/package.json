{
  "name": "@wasla/api",
  "version": "1.0.0",
  "private": true,
  "description": "WASLA independent backend API",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src/server.test.ts src/database.test.ts",
    "test:integration": "vitest run src/database.integration.test.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@wasla/shared": "workspace:*",
    "better-auth": "1.7.15",
    "@better-auth/drizzle-adapter": "1.7.15",
    "drizzle-orm": "0.45.4",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.31.11",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
